{%- comment -%}Vintage Oak Barrel Illustration for Store Block{%- endcomment -%}
<svg class="bs-barrel-art" viewBox="0 0 100 120" width="84" height="100" fill="none" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="bsBarrelWood" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#241a12"/>
      <stop offset="30%" stop-color="#4a3625"/>
      <stop offset="60%" stop-color="#38291c"/>
      <stop offset="100%" stop-color="#1c140e"/>
    </linearGradient>
    <linearGradient id="bsHoopGold" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#8a6d3b"/>
      <stop offset="50%" stop-color="#caa161"/>
      <stop offset="100%" stop-color="#6e5428"/>
    </linearGradient>
  </defs>
  <!-- Barrel body -->
  <path d="M22 12 C10 38, 10 82, 22 108 L78 108 C90 82, 90 38, 78 12 Z" fill="url(#bsBarrelWood)" stroke="#8a6d3b" stroke-width="1.2"/>
  <!-- Top and bottom head rims -->
  <ellipse cx="50" cy="12" rx="28" ry="6" fill="#2d2016" stroke="#caa161" stroke-width="1.2"/>
  <ellipse cx="50" cy="108" rx="28" ry="6" fill="#18110b" stroke="#8a6d3b" stroke-width="1.2"/>
  <!-- Steel hoops -->
  <path d="M18 30 C30 35, 70 35, 82 30" stroke="url(#bsHoopGold)" stroke-width="2.4" fill="none"/>
  <path d="M14 48 C30 53, 70 53, 86 48" stroke="url(#bsHoopGold)" stroke-width="2.6" fill="none"/>
  <path d="M14 72 C30 77, 70 77, 86 72" stroke="url(#bsHoopGold)" stroke-width="2.6" fill="none"/>
  <path d="M18 90 C30 95, 70 95, 82 90" stroke="url(#bsHoopGold)" stroke-width="2.4" fill="none"/>
  <!-- Oak stave wood grain vertical seams -->
  <path d="M33 15 C26 40, 26 80, 33 105" stroke="#16100a" stroke-width="1.2" opacity="0.8"/>
  <path d="M42 16 C38 42, 38 78, 42 106" stroke="#16100a" stroke-width="1.2" opacity="0.8"/>
  <path d="M50 16 C50 42, 50 78, 50 106" stroke="#16100a" stroke-width="1.2" opacity="0.8"/>
  <path d="M58 16 C62 42, 62 78, 58 106" stroke="#16100a" stroke-width="1.2" opacity="0.8"/>
  <path d="M67 15 C74 40, 74 80, 67 105" stroke="#16100a" stroke-width="1.2" opacity="0.8"/>
  <!-- Bung hole / stopper on bilge -->
  <circle cx="50" cy="60" r="3" fill="#110c07" stroke="#caa161" stroke-width="1"/>
</svg>
