{% doc %}
  Renders the cart notification dialog.

  @param {string} [color_scheme] - The color scheme applied to the notification. When blank, no color-scheme class is added.
  @param {string} [desktop_menu_type] - The desktop menu type. When `drawer`, the page-width wrapper class is omitted.

  @example
  {% render 'cart-notification', color_scheme: section.settings.color_scheme, desktop_menu_type: section.settings.menu_type_desktop %}
{% enddoc %}

<cart-notification>
  <div class="cart-notification-wrapper{% if desktop_menu_type != 'drawer' %} page-width{% endif %}">
    <div
      id="cart-notification"
      class="cart-notification focus-inset{% if color_scheme %} color-{{ color_scheme }} gradient{% endif %}"
      aria-modal="true"
      aria-label="{{ 'general.cart.item_added' | t }}"
      role="dialog"
      tabindex="-1"
    >
      <div class="cart-notification__header">
        <h2 class="cart-notification__heading caption-large text-body">
          {{- 'icon-checkmark.svg' | inline_asset_content -}}
          {{ 'general.cart.item_added' | t }}
        </h2>
        <button
          type="button"
          class="cart-notification__close modal__close-button link link--text focus-inset"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>
      <div id="cart-notification-product" class="cart-notification-product"></div>
      <div class="cart-notification-upsell">
        <div class="cart-notification-upsell__header">
          <span class="cart-notification-upsell__eyebrow">Pairs well with</span>
          <h3 class="cart-notification-upsell__title">You may also like</h3>
        </div>
        <div class="cart-notification-upsell__grid">
          {%- assign upsell_count = 0 -%}
          {%- for rec in collections.all.products limit: 12 -%}
            {%- if rec.available and upsell_count < 2 -%}
              <div class="cart-notification-upsell__card">
                <a href="{{ rec.url }}" class="cart-notification-upsell__card-img">
                  {%- if rec.featured_image -%}
                    {{ rec.featured_image | image_url: width: 140 | image_tag: loading: 'lazy', alt: rec.title }}
                  {%- endif -%}
                </a>
                <div class="cart-notification-upsell__card-info">
                  <a href="{{ rec.url }}" class="cart-notification-upsell__card-title">{{ rec.title | escape }}</a>
                  <div class="cart-notification-upsell__card-row">
                    <span class="cart-notification-upsell__card-price">{{ rec.price | money }}</span>
                    <form action="{{ routes.cart_add_url }}" method="post" class="cart-notification-upsell__card-form">
                      <input type="hidden" name="id" value="{{ rec.selected_or_first_available_variant.id }}">
                      <button type="submit" class="cart-notification-upsell__card-btn">
                        <span>+ Add</span>
                      </button>
                    </form>
                  </div>
                </div>
              </div>
              {%- assign upsell_count = upsell_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      <div class="cart-notification__links">
        <a
          href="{{ routes.cart_url }}"
          id="cart-notification-button"
          class="button button--secondary button--full-width"
        >
          {{- 'general.cart.view_empty_cart' | t -}}
        </a>
        <form action="{{ routes.cart_url }}" method="post" id="cart-notification-form">
          <button class="button button--primary button--full-width" name="checkout">
            {{ 'sections.cart.checkout' | t }}
          </button>
        </form>
        <button type="button" class="link button-label">{{ 'general.continue_shopping' | t }}</button>
      </div>
    </div>
  </div>
</cart-notification>
{% style %}
  .cart-notification {
    display: none;
  }
{% endstyle %}
