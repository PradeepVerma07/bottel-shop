{% comment %}Loaded once in the layout; all custom sections share this small stylesheet and script.{% endcomment %}
{% style %}
  @font-face { font-family: 'Bottle Anton'; src: url('{{ 'bs-anton.woff2' | asset_url }}') format('woff2'); font-style: normal; font-weight: 400; font-display: swap; }
  @font-face { font-family: 'Bottle Montserrat'; src: url('{{ 'bs-montserrat.woff2' | asset_url }}') format('woff2'); font-style: normal; font-weight: 100 900; font-display: swap; }
  :root {
    --bs-font-heading: {% if settings.bottle_use_theme_fonts %}{{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }}{% else %}'Bottle Anton', Impact, sans-serif{% endif %};
    --bs-font-body: {% if settings.bottle_use_theme_fonts %}{{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }}{% else %}'Bottle Montserrat', Arial, sans-serif{% endif %};
    --bs-gutter: clamp(24px, 5.5vw, {{ settings.bottle_gutter | default: 80 }}px);
    --bs-gutter-mobile: {{ settings.bottle_gutter_mobile | default: 22 }}px;
    --bs-site-width: {{ settings.bottle_page_width | default: 1600 }}px;
    --bs-global-bg: {{ settings.bottle_background | default: '#15120e' }};
    --bs-global-text: {{ settings.bottle_text | default: '#f4ebd9' }};
    --bs-global-accent: {{ settings.bottle_accent | default: '#d6ad74' }};
    --bs-global-bg-rgb: {{ settings.bottle_background | default: '#15120e' | color_extract: 'red' }}, {{ settings.bottle_background | default: '#15120e' | color_extract: 'green' }}, {{ settings.bottle_background | default: '#15120e' | color_extract: 'blue' }};
    --bs-global-text-rgb: {{ settings.bottle_text | default: '#f4ebd9' | color_extract: 'red' }}, {{ settings.bottle_text | default: '#f4ebd9' | color_extract: 'green' }}, {{ settings.bottle_text | default: '#f4ebd9' | color_extract: 'blue' }};
    --bs-global-accent-rgb: {{ settings.bottle_accent | default: '#d6ad74' | color_extract: 'red' }}, {{ settings.bottle_accent | default: '#d6ad74' | color_extract: 'green' }}, {{ settings.bottle_accent | default: '#d6ad74' | color_extract: 'blue' }};
    --bs-global-button-text-rgb: {{ settings.bottle_button_text | default: '#15120e' | color_extract: 'red' }}, {{ settings.bottle_button_text | default: '#15120e' | color_extract: 'green' }}, {{ settings.bottle_button_text | default: '#15120e' | color_extract: 'blue' }};
    --bs-button-size: {{ settings.bottle_button_size | default: 12 }}px;
  }
{% endstyle %}
{{ 'bottle-shop.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bottle-shop.js' | asset_url }}" defer="defer"></script>
{{ 'bottle-commerce.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bottle-commerce.js' | asset_url }}" defer="defer"></script>
