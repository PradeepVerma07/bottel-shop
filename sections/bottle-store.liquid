{%- liquid
  assign photo_fallback = ''
  assign wood_fallback = ''
  if section.settings.use_reference_images
    assign photo_fallback = 'bs-store.png'
    assign wood_fallback = 'bs-wood.png'
  endif
-%}
<div class="bs bs-store{% if section.settings.image_position == 'left' %} bs-store--reverse{% endif %}"{% if section.settings.anchor != blank %} data-bs-anchor="{{ section.settings.anchor | handleize }}"{% endif %} style="{% render 'bottle-vars', section: section %} --bs-panel-width: {{ section.settings.panel_width }}%; --bs-store-height: {{ section.settings.height }}px; --bs-store-photo-mobile: {{ section.settings.photo_height_mobile }}px; --bs-panel-shade: {{ section.settings.panel_overlay | divided_by: 100.0 }}; --bs-badge-opacity: {{ section.settings.badge_opacity | divided_by: 100.0 }};">
  <div class="bs-store__panel">
    {% render 'bottle-media', image: section.settings.background_image, fallback: wood_fallback, class: 'bs-background', width: 1024, height: 1536, decorative: true %}
    {% if section.settings.eyebrow != blank %}<p class="bs-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h2 class="bs-heading"><span class="bs-store__heading-main">{{ section.settings.heading | escape | newline_to_br }}</span>{% if section.settings.accent_heading != blank %}<br class="bs-store__heading-break"><span class="bs-store__heading-accent" style="color: var(--bs-accent)">{{ section.settings.accent_heading | escape | newline_to_br }}</span>{% endif %}</h2>
    <div class="bs-copy">{{ section.settings.description }}</div>
    <div class="bs-store__details">{% for block in section.blocks %}<div class="bs-detail" {{ block.shopify_attributes }}>{% if section.settings.show_icons and block.settings.icon != 'none' %}<span class="bs-detail__icon">{% render 'bottle-icon', icon: block.settings.icon %}</span>{% endif %}<div><h3>{{ block.settings.heading | escape }}</h3>{% if block.settings.link != blank %}<a class="bs-copy" href="{{ block.settings.link }}">{{ block.settings.body }}</a>{% else %}<div class="bs-copy">{{ block.settings.body }}</div>{% endif %}</div></div>{% endfor %}</div>
    <div class="bs-actions">{% render 'bottle-button', label: section.settings.button_label, link: section.settings.button_link, new_tab: section.settings.button_new_tab %}</div>
    {% if section.settings.show_badge %}<div class="bs-store__badge">{% render 'bottle-media', image: section.settings.badge, fallback: 'bs-logo.png', width: 1254, height: 1254, decorative: true, sizes: '160px' %}</div>{% endif %}
  </div>
  <div class="bs-store__photo{% if section.settings.image == blank and photo_fallback != blank %} bs-store__photo--included{% endif %}">{% render 'bottle-media', image: section.settings.image, fallback: photo_fallback, width: 1697, height: 927, alt: section.settings.image_alt, sizes: '(min-width: 801px) 68vw, 100vw' %}</div>
</div>

{% schema %}
{
  "name": "Bottle Shop store",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Optional unique anchor"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Visit the store"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Good\ndrinks."
    },
    {
      "type": "textarea",
      "id": "accent_heading",
      "label": "Accent heading",
      "default": "Great\npeople."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Come in and explore our curated selection of wines, spirits, beers and more. We're always here to help you find the right bottle for any occasion.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get directions"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "button_new_tab",
      "label": "Open button link in a new tab",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_icons",
      "label": "Show detail icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Images and layout"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Store photograph"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Photo alternative text",
      "default": "Inside the Bottle Shop and Sipping Station"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Sidebar background"
    },
    {
      "type": "checkbox",
      "id": "use_reference_images",
      "label": "Use included images when pickers are empty",
      "default": true
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Photo position",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "panel_width",
      "label": "Desktop sidebar width",
      "min": 28,
      "max": 48,
      "step": 1,
      "unit": "%",
      "default": 32
    },
    {
      "type": "range",
      "id": "height",
      "label": "Minimum desktop height",
      "min": 600,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 780
    },
    {
      "type": "range",
      "id": "photo_height_mobile",
      "label": "Mobile photo height",
      "min": 240,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 340
    },
    {
      "type": "range",
      "id": "panel_overlay",
      "label": "Sidebar dark overlay",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 20
    },
    {
      "type": "header",
      "content": "Decorative badge"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badge",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "badge",
      "label": "Badge image"
    },
    {
      "type": "range",
      "id": "badge_opacity",
      "label": "Badge opacity",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "%",
      "default": 15
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background override"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text override"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent override"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background override"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text override"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size \u2014 desktop",
      "min": 28,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 62
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size \u2014 mobile",
      "min": 28,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 62
    },
    {
      "type": "checkbox",
      "id": "inherit_body_size",
      "label": "Use global body text size",
      "default": true
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Custom body size (disable global size first)",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Contact detail",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Label",
          "default": "Location"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Information",
          "default": "<p>Longmeadow, MA</p>"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "location",
              "label": "Location"
            },
            {
              "value": "clock",
              "label": "Clock"
            },
            {
              "value": "phone",
              "label": "Phone"
            },
            {
              "value": "none",
              "label": "None"
            }
          ],
          "default": "location"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bottle Shop store",
      "blocks": [
        {
          "type": "detail",
          "settings": {
            "heading": "Location",
            "body": "<p>Longmeadow, MA</p>",
            "icon": "location"
          }
        },
        {
          "type": "detail",
          "settings": {
            "heading": "Store hours",
            "body": "<p>Mon \u2013 Sat &nbsp;9AM \u2013 9PM<br>Sun &nbsp;10AM \u2013 6PM</p>",
            "icon": "clock"
          }
        },
        {
          "type": "detail",
          "settings": {
            "heading": "Contact",
            "body": "<p>(413) 555\u20130123</p>",
            "icon": "phone"
          }
        }
      ],
      "settings": {
        "button_link": "https://www.google.com/maps/search/?api=1&query=The+Bottle+Shop+Longmeadow+MA"
      }
    }
  ]
}
{% endschema %}
