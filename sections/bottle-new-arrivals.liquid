{%- liquid
  assign target_collection = section.settings.collection
  if target_collection == blank or target_collection.products_count == 0
    if collections['new-arrivals'] != blank and collections['new-arrivals'].products_count > 0
      assign target_collection = collections['new-arrivals']
    elsif collections['new'] != blank and collections['new'].products_count > 0
      assign target_collection = collections['new']
    else
      assign target_collection = collections.all
    endif
  endif

  if section.settings.sort_by_newest
    assign product_list = target_collection.products | sort: 'created_at' | reverse
  else
    assign product_list = target_collection.products
  endif

  assign max_products = section.settings.products_to_show | default: 4
  assign rendered_count = 0

  assign badge_value = ''
  if section.settings.show_badge and section.settings.badge_text != blank
    assign badge_value = section.settings.badge_text
  endif

  assign shop_url = section.settings.button_link
  if shop_url == blank
    assign shop_url = target_collection.url | default: routes.all_products_collection_url
  endif
-%}

{%- capture new_arrival_cards -%}
  {%- for product in product_list limit: 50 -%}
    {%- if section.settings.show_sold_out or product.available -%}
      {% render 'bottle-product-card',
        card_product: product,
        section_id: section.id,
        badge: badge_value,
        show_category: section.settings.show_product_category,
        show_description: section.settings.show_description,
        quick_add: section.settings.quick_add,
        add_label: section.settings.add_label,
        options_label: section.settings.options_label,
        sold_out_label: section.settings.sold_out_label,
        from_label: section.settings.from_label
      %}
      {%- assign rendered_count = rendered_count | plus: 1 -%}
      {%- if rendered_count >= max_products %}{% break %}{% endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if rendered_count < max_products -%}
    {%- for product in collections.all.products limit: 50 -%}
      {%- unless product_list contains product -%}
        {%- if section.settings.show_sold_out or product.available -%}
          {% render 'bottle-product-card',
            card_product: product,
            section_id: section.id,
            badge: badge_value,
            show_category: section.settings.show_product_category,
            show_description: section.settings.show_description,
            quick_add: section.settings.quick_add,
            add_label: section.settings.add_label,
            options_label: section.settings.options_label,
            sold_out_label: section.settings.sold_out_label,
            from_label: section.settings.from_label
          %}
          {%- assign rendered_count = rendered_count | plus: 1 -%}
          {%- if rendered_count >= max_products %}{% break %}{% endif -%}
        {%- endif -%}
      {%- endunless -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

<section
  id="BottleNewArrivals-{{ section.id }}"
  class="bs bs-new-arrivals bs-new-arrivals--mobile-{{ section.settings.columns_mobile | default: '2' }}{% if section.settings.show_wood_texture %} bs-new-arrivals--wood{% endif %}"
  style="
    {% render 'bottle-vars', section: section %}
    --bs-shop-columns: {{ section.settings.columns }};
    --bs-mobile-columns: {{ section.settings.columns_mobile | default: '2' }};
    --bs-card-title-size: {{ section.settings.card_title_size }}px;
    --bs-card-image-fit: {{ section.settings.image_fit }};
    --bs-card-bg: {{ section.settings.card_color }};
    --bs-card-ink: {{ section.settings.card_text_color }};
    --bs-card-texture: {% if section.settings.card_texture %}url('{{ 'bs-parchment.png' | asset_url }}'){% else %}none{% endif %};
  "
>
  <div class="bs-inner">
    <div class="bs-related-heading bs-new-arrivals__heading{% if section.settings.center_header %} bs-new-arrivals__heading--center{% endif %}">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="bs-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        <h2 class="bs-heading">{{ section.settings.heading | escape }}</h2>
        {% if section.settings.description != blank %}
          <div class="bs-copy bs-new-arrivals__desc">{{ section.settings.description }}</div>
        {% endif %}
      </div>
      {% if section.settings.show_button and section.settings.button_label != blank %}
        {% render 'bottle-button', label: section.settings.button_label, link: shop_url, style: 'text' %}
      {% endif %}
    </div>

    {% if rendered_count > 0 %}
      <div class="bs-product-grid">
        {{ new_arrival_cards }}
      </div>
    {% elsif request.design_mode %}
      <div class="bs-empty-state" style="text-align: center; padding: 50px 20px;">
        <p class="bs-copy">{{ section.settings.editor_empty_message | default: 'Add products to your store or select a collection to display new arrivals.' | escape }}</p>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Bottle Shop new arrivals",
  "tag": "section",
  "class": "bottle-section-new-arrivals",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Fresh Pours & Rare Finds"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "checkbox",
      "id": "center_header",
      "label": "Center align header text",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show 'Explore All' link",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore All New"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave blank to link directly to the collection."
    },
    {
      "type": "header",
      "content": "Collection & Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave blank to automatically pull newest products from your catalog."
    },
    {
      "type": "checkbox",
      "id": "sort_by_newest",
      "label": "Prioritize newest created products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_sold_out",
      "label": "Include sold-out products",
      "default": true
    },
    {
      "type": "header",
      "content": "Product Badge"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badge on products",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge label",
      "default": "New"
    },
    {
      "type": "header",
      "content": "Card Details"
    },
    {
      "type": "checkbox",
      "id": "show_product_category",
      "label": "Show category / spirit type",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description snippet",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "quick_add",
      "label": "Enable quick add to cart",
      "default": true
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Add to cart button label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "options_label",
      "label": "View details button label",
      "default": "View details"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "from_label",
      "label": "Price 'From' label",
      "default": "From"
    },
    {
      "type": "header",
      "content": "Card Styling"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background color",
      "default": "#eddfc5"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card text color",
      "default": "#15120e"
    },
    {
      "type": "checkbox",
      "id": "card_texture",
      "label": "Enable parchment texture on cards",
      "default": true
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Card title font size",
      "min": 18,
      "max": 36,
      "step": 1,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ],
      "default": "cover"
    },
    {
      "type": "header",
      "content": "Section Appearance"
    },
    {
      "type": "checkbox",
      "id": "show_wood_texture",
      "label": "Show subtle wood texture background",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background color",
      "default": "#15120e"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Section text color",
      "default": "#f4ebd9"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / Gold color",
      "default": "#d6ad74"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading font size (desktop)",
      "min": 32,
      "max": 80,
      "step": 2,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading font size (mobile)",
      "min": 24,
      "max": 48,
      "step": 2,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "editor_empty_message",
      "label": "Editor empty message",
      "default": "Select a collection containing published products to preview new arrivals."
    }
  ],
  "presets": [
    {
      "name": "Bottle Shop new arrivals",
      "settings": {
        "eyebrow": "Fresh Pours & Rare Finds",
        "heading": "New Arrivals",
        "show_button": true,
        "button_label": "Explore All New",
        "products_to_show": 4,
        "columns": 4,
        "columns_mobile": "2",
        "show_badge": true,
        "badge_text": "New",
        "quick_add": true
      }
    }
  ]
}
{% endschema %}
