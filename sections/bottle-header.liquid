{%- liquid
  assign overlay = false
  if section.settings.overlay_home
    assign overlay = true
  endif
  assign logo_fallback = ''
  if section.settings.use_default_logo
    assign logo_fallback = 'bs-logo.png'
  endif
-%}
<header class="bs bs-header bs-header--home{% if overlay %} bs-header--overlay{% endif %}" style="{% render 'bottle-vars', section: section %} --bs-logo-width: {{ section.settings.logo_width }}px; --bs-mobile-logo: {{ section.settings.logo_width_mobile }}px; --bs-nav-size: {{ section.settings.menu_size }}px; --bs-padding-top-mobile: {{ section.settings.padding_top_mobile | default: 10 }}px; --bs-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile | default: 10 }}px;">
  <div class="bs-inner bs-header__inner">
    <a class="bs-logo" href="{{ routes.root_url }}" aria-label="{{ section.settings.brand_name | escape }}">
      {% if section.settings.logo != blank or logo_fallback != blank %}
        {% render 'bottle-media', image: section.settings.logo, fallback: logo_fallback, width: 1254, height: 1254, alt: section.settings.brand_name, loading: 'eager', sizes: '160px' %}
      {% else %}<span class="bs-logo-text">{{ section.settings.brand_name | escape }}</span>{% endif %}
    </a>
    <div class="bs-header__content">
      <nav class="bs-desktop-nav" aria-label="{{ section.settings.menu_label | escape }}">
        <ul class="bs-navigation">
          {% if section.settings.menu != blank %}
            {% for link in section.settings.menu.links %}
              <li>{% if link.links != blank %}<details><summary>{{ link.title | escape }}</summary><ul class="bs-nav-dropdown">{% for child in link.links %}<li><a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a></li>{% endfor %}</ul></details>{% else %}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>{% endif %}</li>
            {% endfor %}
          {% else %}
            {% for block in section.blocks %}<li {{ block.shopify_attributes }}><a href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.label | escape }}</a></li>{% endfor %}
          {% endif %}
        </ul>
      </nav>
      {% if section.settings.show_search %}
        <form class="bs-search" action="{{ routes.search_url }}" method="get" role="search">
          <button class="bs-icon-link" type="submit" aria-label="{{ section.settings.search_label | escape }}">{% render 'bottle-icon', icon: 'search' %}</button>
          <label class="bs-sr-only" for="BottleSearch-{{ section.id }}">{{ section.settings.search_label | escape }}</label>
          <input id="BottleSearch-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.search_placeholder | escape }}">
          <input type="hidden" name="options[prefix]" value="last">
        </form>
      {% endif %}
      <div class="bs-header__actions">
        {% if section.settings.show_wishlist != false and settings.bottle_show_wishlist != false %}
          <button type="button" class="bs-icon-link bs-wishlist-header-link" data-bs-wishlist-open aria-label="{{ settings.bottle_wishlist_view_label | default: 'Wishlist' | escape }}">
            <svg class="bs-icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M20.8 4.7a5.5 5.5 0 0 0-7.8 0L12 5.8l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.5a5.5 5.5 0 0 0 0-7.8Z"/>
            </svg>
            <span class="bs-wishlist-count" data-bs-wishlist-count hidden>0</span>
          </button>
        {% endif %}
        {% if section.settings.show_search %}<details class="bs-mobile-search"><summary class="bs-icon-link" aria-label="{{ section.settings.search_label | escape }}">{% render 'bottle-icon', icon: 'search' %}</summary><form class="bs-mobile-search__form" action="{{ routes.search_url }}" method="get" role="search"><label class="bs-sr-only" for="BottleMobileSearch-{{ section.id }}">{{ section.settings.search_label | escape }}</label><input id="BottleMobileSearch-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.search_placeholder | escape }}"><input type="hidden" name="options[prefix]" value="last"><button class="bs-icon-link" type="submit" aria-label="{{ section.settings.search_label | escape }}">{% render 'bottle-icon', icon: 'search' %}</button></form></details>{% endif %}
        {% if section.settings.show_account and shop.customer_accounts_enabled %}<a class="bs-icon-link bs-header__account" href="{{ routes.account_url }}" aria-label="{{ section.settings.account_label | escape }}">{% render 'bottle-icon', icon: 'user' %}</a>{% endif %}
        {% if section.settings.show_cart %}<a id="cart-icon-bubble" class="bs-icon-link bs-cart-link" href="{{ routes.cart_url }}" aria-label="{{ section.settings.cart_label | escape }} ({{ cart.item_count }})">{% render 'bottle-icon', icon: 'bag' %}<svg class="bs-icon bs-cart-phone" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 3h3l3 13h11l3-10H6M8 19h11"/><circle cx="9" cy="22" r=".7"/><circle cx="18" cy="22" r=".7"/></svg><span class="bs-cart-count" aria-hidden="true">{{ cart.item_count }}</span></a>{% endif %}
        <details class="bs-mobile-menu" id="BottleMobileMenu">
          <summary class="bs-icon-link" aria-label="{{ section.settings.menu_label | escape }}">
            {% render 'bottle-icon', icon: 'menu' %}
          </summary>
          <div class="bs-mobile-menu__portal">
            <div class="bs-mobile-menu__backdrop" data-bs-menu-close></div>
            <nav class="bs-mobile-menu__drawer" aria-label="{{ section.settings.menu_label | escape }}" style="--bs-mobile-menu-bg: url('{{ 'bs-mobile-menu-bg.jpg' | asset_url }}');">
              <div class="bs-mobile-menu__header">
                <a class="bs-mobile-menu__logo" href="{{ routes.root_url }}" aria-label="{{ section.settings.brand_name | escape }}">
                  {% if section.settings.logo != blank or logo_fallback != blank %}
                    {% render 'bottle-media', image: section.settings.logo, fallback: logo_fallback, width: 140, height: 140, alt: section.settings.brand_name, loading: 'eager', sizes: '70px' %}
                  {% else %}
                    <span class="bs-logo-text">{{ section.settings.brand_name | escape }}</span>
                  {% endif %}
                </a>
                <button type="button" class="bs-mobile-menu__close" data-bs-menu-close aria-label="Close menu">
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </button>
              </div>

              <form class="bs-mobile-menu__search" action="{{ routes.search_url }}" method="get" role="search">
                <div class="bs-mobile-menu__search-field">
                  <svg class="bs-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.8"/><path d="m16 16 5 5"/></svg>
                  <input type="search" name="q" placeholder="Search products..." aria-label="Search products" autocomplete="off">
                  <input type="hidden" name="type" value="product">
                  <input type="hidden" name="options[prefix]" value="last">
                </div>
              </form>

              <ul class="bs-mobile-menu__list">
                {% if section.settings.menu != blank %}
                  {% for link in section.settings.menu.links %}
                    {% assign handle = link.title | downcase %}
                    {% assign icon_name = 'wine' %}
                    {% if handle contains 'spirit' %}{% assign icon_name = 'spirits' %}
                    {% elsif handle contains 'beer' %}{% assign icon_name = 'beer' %}
                    {% elsif handle contains 'ready' or handle contains 'drink' %}{% assign icon_name = 'ready-to-drink' %}
                    {% elsif handle contains 'gift' %}{% assign icon_name = 'gifts' %}
                    {% elsif handle contains 'deal' or handle contains 'sale' %}{% assign icon_name = 'deals' %}
                    {% elsif handle contains 'about' or handle contains 'story' %}{% assign icon_name = 'about' %}
                    {% endif %}
                    <li>
                      <a href="{{ link.url }}" class="bs-mobile-menu__link">
                        <span class="bs-mobile-menu__link-icon">{% render 'bottle-menu-icon', icon: icon_name %}</span>
                        <span class="bs-mobile-menu__link-title">{{ link.title | escape }}</span>
                        <span class="bs-mobile-menu__link-chevron">
                          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                        </span>
                      </a>
                    </li>
                  {% endfor %}
                {% else %}
                  {% for block in section.blocks %}
                    {% assign handle = block.settings.label | downcase %}
                    {% assign icon_name = 'wine' %}
                    {% if handle contains 'spirit' %}{% assign icon_name = 'spirits' %}
                    {% elsif handle contains 'beer' %}{% assign icon_name = 'beer' %}
                    {% elsif handle contains 'ready' or handle contains 'drink' %}{% assign icon_name = 'ready-to-drink' %}
                    {% elsif handle contains 'gift' %}{% assign icon_name = 'gifts' %}
                    {% elsif handle contains 'deal' or handle contains 'sale' %}{% assign icon_name = 'deals' %}
                    {% elsif handle contains 'about' or handle contains 'story' %}{% assign icon_name = 'about' %}
                    {% endif %}
                    <li {{ block.shopify_attributes }}>
                      <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="bs-mobile-menu__link">
                        <span class="bs-mobile-menu__link-icon">{% render 'bottle-menu-icon', icon: icon_name %}</span>
                        <span class="bs-mobile-menu__link-title">{{ block.settings.label | escape }}</span>
                        <span class="bs-mobile-menu__link-chevron">
                          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                        </span>
                      </a>
                    </li>
                  {% endfor %}
                {% endif %}
              </ul>

              <div class="bs-mobile-menu__actions">
                <a href="{{ routes.account_url }}" class="bs-mobile-menu__action">
                  {% render 'bottle-icon', icon: 'user' %}
                  <span>My Account</span>
                </a>
                <span class="bs-mobile-menu__action-divider" aria-hidden="true"></span>
                <a href="{{ routes.cart_url }}" class="bs-mobile-menu__action">
                  {% render 'bottle-icon', icon: 'bag' %}
                  <span>Cart ({{ cart.item_count }})</span>
                </a>
              </div>

              <div class="bs-mobile-menu__store">
                <div class="bs-mobile-menu__store-info">
                  <div class="bs-mobile-menu__store-item bs-mobile-menu__store-item--address">
                    <span class="bs-mobile-menu__store-icon">{% render 'bottle-icon', icon: 'location' %}</span>
                    <div>
                      <h3 class="bs-mobile-menu__store-heading">{{ section.settings.mobile_store_heading | default: 'OUR STORE' | escape }}</h3>
                      <div class="bs-mobile-menu__store-text">{{ section.settings.mobile_store_address | default: '<p>923 Shaker Road,<br>Longmeadow, MA 01106</p>' }}</div>
                    </div>
                  </div>
                  <div class="bs-mobile-menu__store-item">
                    <span class="bs-mobile-menu__store-icon">{% render 'bottle-icon', icon: 'clock' %}</span>
                    <div class="bs-mobile-menu__store-text">{{ section.settings.mobile_store_hours | default: '<p>Mon – Sat: 9AM – 9PM<br>Sun: 10AM – 6PM</p>' }}</div>
                  </div>
                  <div class="bs-mobile-menu__store-item">
                    <span class="bs-mobile-menu__store-icon">{% render 'bottle-icon', icon: 'phone' %}</span>
                    <a href="tel:{{ section.settings.mobile_store_phone | default: '+1 (413) 384-2154' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}" class="bs-mobile-menu__store-text bs-mobile-menu__store-phone">{{ section.settings.mobile_store_phone | default: '+1 (413) 384-2154' | escape }}</a>
                  </div>
                </div>
              </div>

              <a href="{{ section.settings.mobile_cta_link | default: routes.all_products_collection_url }}" class="bs-mobile-menu__cta">
                <span>{{ section.settings.mobile_cta_label | default: 'SHOP ALL PRODUCTS' | escape }}</span>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
              </a>

              <div class="bs-mobile-menu__footer">
                <p class="bs-mobile-menu__legal">
                  <span class="bs-mobile-menu__legal-line" aria-hidden="true"></span>
                  <span class="bs-mobile-menu__legal-text">{{ section.settings.mobile_footer_text | default: 'Please enjoy responsibly. 21+ Only.' | escape }}</span>
                  <span class="bs-mobile-menu__legal-line" aria-hidden="true"></span>
                </p>
              </div>
            </nav>
          </div>
        </details>
      </div>
    </div>
  </div>
</header>
{% if settings.cart_type == 'notification' %}
  {{ 'component-cart-notification.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>
  {% render 'cart-notification', color_scheme: section.settings.cart_color_scheme, desktop_menu_type: 'dropdown' %}
{% endif %}

{% schema %}
{
  "name": "Bottle Shop header",
  "tag": "div",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "checkbox",
      "id": "compact_inner_pages",
      "label": "Compact header on inner pages",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "cart_color_scheme",
      "label": "Native cart notification colors",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "checkbox",
      "id": "use_default_logo",
      "label": "Use included logo when no image is selected",
      "default": true
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name / logo alternative text",
      "default": "The Bottle Shop"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width — desktop",
      "min": 60,
      "max": 220,
      "step": 2,
      "unit": "px",
      "default": 140
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Logo width — mobile",
      "min": 50,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 84
    },
    {
      "type": "checkbox",
      "id": "overlay_home",
      "label": "Transparent overlay header on all pages",
      "default": true
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Shopify menu",
      "info": "Choose a menu, or leave empty to use the editable link blocks."
    },
    {
      "type": "text",
      "id": "menu_label",
      "label": "Navigation label",
      "default": "Main navigation"
    },
    {
      "type": "range",
      "id": "menu_size",
      "label": "Menu text size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show wishlist",
      "default": true
    },
    {
      "type": "text",
      "id": "search_label",
      "label": "Search accessibility label",
      "default": "Search products"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search products..."
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account link when accounts are enabled",
      "default": true
    },
    {
      "type": "text",
      "id": "account_label",
      "label": "Account label",
      "default": "Your account"
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart",
      "default": true
    },
    {
      "type": "text",
      "id": "cart_label",
      "label": "Cart label",
      "default": "Your shopping bag"
    },
    {
      "type": "header",
      "content": "Mobile Drawer Menu"
    },
    {
      "type": "text",
      "id": "mobile_store_heading",
      "label": "Store info heading",
      "default": "OUR STORE"
    },
    {
      "type": "richtext",
      "id": "mobile_store_address",
      "label": "Store address",
      "default": "<p>923 Shaker Road,<br>Longmeadow, MA 01106</p>"
    },
    {
      "type": "richtext",
      "id": "mobile_store_hours",
      "label": "Store hours",
      "default": "<p>Mon – Sat: 9AM – 9PM<br>Sun: 10AM – 6PM</p>"
    },
    {
      "type": "text",
      "id": "mobile_store_phone",
      "label": "Store phone",
      "default": "+1 (413) 384-2154"
    },
    {
      "type": "text",
      "id": "mobile_cta_label",
      "label": "Mobile menu CTA label",
      "default": "SHOP ALL PRODUCTS"
    },
    {
      "type": "url",
      "id": "mobile_cta_link",
      "label": "Mobile menu CTA link"
    },
    {
      "type": "text",
      "id": "mobile_footer_text",
      "label": "Mobile menu footer legal note",
      "default": "Please enjoy responsibly. 21+ Only."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background override"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text override"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent override"
    },
    {
      "type": "checkbox",
      "id": "inherit_body_size",
      "label": "Use global body text size",
      "default": true
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Custom body size (disable global size first)",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Spacing (Desktop)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "header",
      "content": "Spacing (Mobile)"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Navigation link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "default": "/collections/all"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bottle Shop header",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "label": "Wine",
            "link": "/collections/wine"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Spirits",
            "link": "/collections/spirits"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Beer",
            "link": "/collections/beer"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Ready to drink",
            "link": "/collections/ready-to-drink"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Gifts",
            "link": "/collections/gifts"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Deals",
            "link": "/#bottle-newsletter"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "About",
            "link": "/#bottle-story"
          }
        }
      ]
    }
  ],
  "limit": 1
}
{% endschema %}
