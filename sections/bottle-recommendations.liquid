{%- liquid
  assign seed_product = product
  if seed_product == blank and cart.item_count > 0
    assign seed_product = cart.items.first.product
  endif
  assign related_collection = section.settings.collection
  if related_collection == blank and product != blank and product.collections.size > 0
    for col in product.collections
      if col.products_count > 1
        assign related_collection = col
        break
      endif
    endfor
    if related_collection == blank
      assign related_collection = product.collections.first
    endif
  endif
  if related_collection == blank and seed_product != blank and seed_product.collections.size > 0
    for col in seed_product.collections
      if col.products_count > 1
        assign related_collection = col
        break
      endif
    endfor
    if related_collection == blank
      assign related_collection = seed_product.collections.first
    endif
  endif
  if related_collection == blank or related_collection.products_count == 0
    assign related_collection = collections.all
  endif
  if related_collection == blank or related_collection.products_count == 0
    for col in collections
      if col.products_count > 0
        assign related_collection = col
        break
      endif
    endfor
  endif
  assign related_products = related_collection.products
  if section.settings.show_all_products
    assign related_products = collections.all.products
  elsif recommendations.performed and recommendations.products_count > 0
    assign related_products = recommendations.products
  endif
  assign max_products = section.settings.products_to_show | default: 24
  if section.settings.show_all_products
    assign max_products = 50
  endif
  assign rendered_count = 0
  assign rendered_ids = ''
  unless section.settings.include_current_product
    if product != blank
      assign rendered_ids = product.id | append: ','
    endif
  endunless
-%}
{% capture related_cards %}
  {% for recommendation in related_products limit: 50 %}
    {% assign rec_id_token = recommendation.id | append: ',' %}
    {% unless rendered_ids contains rec_id_token %}
      {% if section.settings.show_sold_out or recommendation.available %}
        {% render 'bottle-product-card', card_product: recommendation, section_id: section.id, show_category: section.settings.show_product_category, show_description: section.settings.show_description, title_max_chars: section.settings.title_max_chars, description_max_chars: section.settings.description_max_chars, quick_add: section.settings.quick_add, add_label: section.settings.add_label, options_label: section.settings.options_label, sold_out_label: section.settings.sold_out_label, from_label: section.settings.from_label %}
        {% assign rendered_count = rendered_count | plus: 1 %}
        {% assign rendered_ids = rendered_ids | append: rec_id_token %}
        {% if rendered_count >= max_products %}{% break %}{% endif %}
      {% endif %}
    {% endunless %}
  {% endfor %}
  {% if rendered_count < max_products %}
    {% for recommendation in collections.all.products limit: 50 %}
      {% assign rec_id_token = recommendation.id | append: ',' %}
      {% unless rendered_ids contains rec_id_token %}
        {% if section.settings.show_sold_out or recommendation.available %}
          {% render 'bottle-product-card', card_product: recommendation, section_id: section.id, show_category: section.settings.show_product_category, show_description: section.settings.show_description, title_max_chars: section.settings.title_max_chars, description_max_chars: section.settings.description_max_chars, quick_add: section.settings.quick_add, add_label: section.settings.add_label, options_label: section.settings.options_label, sold_out_label: section.settings.sold_out_label, from_label: section.settings.from_label %}
          {% assign rendered_count = rendered_count | plus: 1 %}
          {% assign rendered_ids = rendered_ids | append: rec_id_token %}
          {% if rendered_count >= max_products %}{% break %}{% endif %}
        {% endif %}
      {% endunless %}
    {% endfor %}
  {% endif %}
  {% if rendered_count < max_products %}
    {% for col in collections %}
      {% for recommendation in col.products limit: 20 %}
        {% assign rec_id_token = recommendation.id | append: ',' %}
        {% unless rendered_ids contains rec_id_token %}
          {% if section.settings.show_sold_out or recommendation.available %}
            {% render 'bottle-product-card', card_product: recommendation, section_id: section.id, show_category: section.settings.show_product_category, show_description: section.settings.show_description, title_max_chars: section.settings.title_max_chars, description_max_chars: section.settings.description_max_chars, quick_add: section.settings.quick_add, add_label: section.settings.add_label, options_label: section.settings.options_label, sold_out_label: section.settings.sold_out_label, from_label: section.settings.from_label %}
            {% assign rendered_count = rendered_count | plus: 1 %}
            {% assign rendered_ids = rendered_ids | append: rec_id_token %}
            {% if rendered_count >= max_products %}{% break %}{% endif %}
          {% endif %}
        {% endunless %}
      {% endfor %}
      {% if rendered_count >= max_products %}{% break %}{% endif %}
    {% endfor %}
  {% endif %}
{% endcapture %}
<div class="bs bs-recommendations bs-recommendations--mobile-{{ section.settings.columns_mobile | default: 'carousel' }}" style="{% render 'bottle-vars', section: section %} --bs-shop-columns: {{ section.settings.columns }}; --bs-mobile-columns: {{ section.settings.columns_mobile | default: 'carousel' }}; --bs-card-title-size: {{ section.settings.card_title_size }}px; --bs-card-image-fit: {{ section.settings.image_fit }}; --bs-card-bg: {{ section.settings.card_color }}; --bs-card-ink: {{ section.settings.card_text_color }}; --bs-card-texture: {% if section.settings.card_texture %}url('{{ 'bs-parchment.png' | asset_url }}'){% else %}none{% endif %};">
  <bottle-recommendations{% if section.settings.automatic and section.settings.show_all_products != true and seed_product != blank %} data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&amp;product_id={{ seed_product.id }}&amp;limit=10&amp;intent=related"{% endif %}>
    <div data-bs-related-content>{% if rendered_count > 0 %}<div class="bs-inner"><div class="bs-related-heading"><div>{% if section.settings.eyebrow != blank %}<p class="bs-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<h2 class="bs-heading">{{ section.settings.heading | escape }}</h2></div><div class="bs-related-actions">{% if section.settings.show_shop_link %}{% render 'bottle-button', label: section.settings.shop_label, link: routes.all_products_collection_url, style: 'text' %}{% endif %}<div class="bs-carousel-nav" data-bs-carousel-controls><button type="button" class="bs-carousel-arrow" data-bs-carousel-prev aria-label="Previous products">{% render 'bottle-icon', icon: 'arrow-left' %}</button><button type="button" class="bs-carousel-arrow" data-bs-carousel-next aria-label="Next products">{% render 'bottle-icon', icon: 'arrow-right' %}</button></div></div></div><div class="bs-product-grid">{{ related_cards }}</div></div>{% elsif request.design_mode %}<div class="bs-inner bs-copy">{{ section.settings.editor_empty_message | escape }}</div>{% endif %}</div>
  </bottle-recommendations>
</div>

{% schema %}
{
  "name": "Bottle Shop related",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "One more good pour"
    },
    {
      "type": "checkbox",
      "id": "show_all_products",
      "label": "Show all store products automatically",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "include_current_product",
      "label": "Include current product in list",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "automatic",
      "label": "Use Shopify related recommendations",
      "default": false
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Fallback / curated collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 50,
      "step": 1,
      "default": 24
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile layout",
      "options": [
        {
          "value": "carousel",
          "label": "Carousel / slider"
        },
        {
          "value": "2",
          "label": "2 columns grid"
        },
        {
          "value": "1",
          "label": "1 column grid"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "checkbox",
      "id": "show_shop_link",
      "label": "Show shop link",
      "default": true
    },
    {
      "type": "text",
      "id": "shop_label",
      "label": "Shop link label",
      "default": "Explore the collection"
    },
    {
      "type": "checkbox",
      "id": "show_sold_out",
      "label": "Include sold-out products",
      "default": true
    },
    {
      "type": "text",
      "id": "editor_empty_message",
      "label": "Editor empty message",
      "default": "Select a collection containing published products to preview recommendations."
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Product title size",
      "min": 18,
      "max": 36,
      "step": 2,
      "default": 26,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Product image fit",
      "options": [
        {
          "value": "contain",
          "label": "Show entire image (Contain)"
        },
        {
          "value": "cover",
          "label": "Fill image area (Cover)"
        }
      ],
      "default": "contain"
    },
    {
      "type": "checkbox",
      "id": "show_product_category",
      "label": "Show product category",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show short description",
      "default": true
    },
    {
      "type": "range",
      "id": "title_max_chars",
      "label": "Max title characters (letters)",
      "min": 10,
      "max": 60,
      "step": 1,
      "default": 22
    },
    {
      "type": "range",
      "id": "description_max_chars",
      "label": "Max description characters (letters)",
      "min": 40,
      "max": 200,
      "step": 5,
      "default": 90
    },
    {
      "type": "checkbox",
      "id": "quick_add",
      "label": "Enable add to cart on single-variant products",
      "default": true
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Add to cart label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "options_label",
      "label": "Choose options label",
      "default": "Choose options"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "from_label",
      "label": "Price from label",
      "default": "From"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Product card background",
      "default": "#eddfc5"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Product card text",
      "default": "#15120e"
    },
    {
      "type": "checkbox",
      "id": "card_texture",
      "label": "Use parchment card texture",
      "default": true
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size \u2014 desktop",
      "min": 28,
      "max": 100,
      "step": 2,
      "default": 46,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size \u2014 mobile",
      "min": 28,
      "max": 72,
      "step": 2,
      "default": 44,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background override"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text override"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent override"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background override"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text override"
    },
    {
      "type": "checkbox",
      "id": "inherit_body_size",
      "label": "Use global body text size",
      "default": true
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Custom body size",
      "min": 12,
      "max": 22,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 42,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 42,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Bottle Shop related",
      "settings": {
        "columns_mobile": "carousel"
      }
    }
  ]
}
{% endschema %}
