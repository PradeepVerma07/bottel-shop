{%- liquid
  assign banner_title = section.settings.heading
  if section.settings.use_collection_title and collection != blank and collection.handle != 'all'
    assign banner_title = collection.title
  endif
  assign banner_description = section.settings.description
  if section.settings.use_collection_description and collection.description != blank
    assign banner_description = collection.description
  endif
  assign fallback = ''
  if section.settings.use_reference_image
    assign fallback = 'bs-shop-banner.png'
  endif
-%}
<div class="bs bs-shop-banner" style="{% render 'bottle-vars', section: section %} --bs-banner-height: {{ section.settings.height }}px; --bs-banner-mobile: {{ section.settings.height_mobile }}px; --bs-banner-image-x: {{ section.settings.image_x }}%; --bs-banner-overlay: {{ section.settings.overlay | divided_by: 100.0 }};">
  {% render 'bottle-media', image: section.settings.image, fallback: fallback, class: 'bs-background', width: 2172, height: 724, decorative: true %}
  <div class="bs-inner">
    {% if section.settings.show_breadcrumbs %}<nav class="bs-breadcrumbs" aria-label="{{ section.settings.breadcrumb_label | escape }}"><a href="{{ routes.root_url }}">{{ section.settings.home_label | escape }}</a><span aria-hidden="true">/</span><span>{{ banner_title | escape }}</span></nav>{% endif %}
    <{{ section.settings.heading_tag }} class="bs-heading">{{ banner_title | escape }}</{{ section.settings.heading_tag }}>
    {% if banner_description != blank %}<div class="bs-copy">{{ banner_description }}</div>{% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Bottle Shop page banner",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop"
    },
    {
      "type": "checkbox",
      "id": "use_collection_title",
      "label": "Use collection title on category pages",
      "default": true
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        {
          "value": "h1",
          "label": "H1 \u2014 page title"
        },
        {
          "value": "h2",
          "label": "H2 \u2014 additional banner"
        }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Explore curated wines, spirits, beers, ready-to-drink favourites and giftable picks.</p>"
    },
    {
      "type": "checkbox",
      "id": "use_collection_description",
      "label": "Use collection description when available",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "checkbox",
      "id": "use_reference_image",
      "label": "Use included shop banner",
      "default": true
    },
    {
      "type": "range",
      "id": "image_x",
      "label": "Background horizontal position",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 65,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Dark overlay",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 35,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Desktop height",
      "min": 180,
      "max": 500,
      "step": 10,
      "default": 250,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Mobile height",
      "min": 180,
      "max": 400,
      "step": 10,
      "default": 250,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Home label",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "breadcrumb_label",
      "label": "Breadcrumb accessibility label",
      "default": "Breadcrumbs"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size \u2014 desktop",
      "min": 28,
      "max": 100,
      "step": 2,
      "default": 72,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size \u2014 mobile",
      "min": 28,
      "max": 72,
      "step": 2,
      "default": 44,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background override"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text override"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent override"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background override"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text override"
    },
    {
      "type": "checkbox",
      "id": "inherit_body_size",
      "label": "Use global body text size",
      "default": true
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Custom body size",
      "min": 12,
      "max": 22,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 30,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Bottle Shop page banner"
    }
  ]
}
{% endschema %}
